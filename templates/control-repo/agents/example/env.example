# Copy to .env next to compose.agent.yml on the app host (chmod 600). Never committed.
# The agent image tag: use the same version as ../../helmsman.version.
AGENT_VERSION=latest
# From Agents > Create agent (or New join token) in the portal. Single use, valid for 1 hour; remove it after the
# first successful start.
IDP_JOIN_TOKEN=
# The group id of the Docker socket on this host: getent group docker | cut -d: -f3
DOCKER_GID=
