# Copy to .env on the IDP host (chmod 600). Never commit it. Generate secrets with: openssl rand -hex 32
IDP_IMAGE=ghcr.io/poppyszn/helmsman-server@sha256:REPLACE_WITH_DIGEST
IDP_BASE_URL=https://idp.example.com
IDP_SESSION_KEY=
IDP_ENCRYPTION_KEY=
IDP_ALLOWED_ORGS=
IDP_BOOTSTRAP_ADMIN_GITHUB_IDS=
IDP_GITHUB_MODE=real
IDP_DISPLAY_TZ=Africa/Lagos
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/opt/helmsman/secrets/github-app.pem
CATALOG_DIR=/opt/helmsman/catalog
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Optional emergency admin. Generate the three values with: go run ./cmd/breakglass-init
IDP_BREAKGLASS_ENABLED=false
