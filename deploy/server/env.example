# Copy to .env in this folder on the host (chmod 600). It is gitignored and a deploy never touches it.
# Generate secrets with: openssl rand -hex 32

# Which optional services run: caddy (TLS), backup (S3Mock plus nightly dump). Comma separated.
COMPOSE_PROFILES=caddy,backup
COMPOSE_PROJECT_NAME=helmsman
# The image tag to run. The deploy pipeline sets it to the commit SHA, so leave this commented out there. When you copy files by hand, uncomment it
# (published by the Publish: Images workflow on every push to main).
# IMAGE_TAG=latest

# The public DNS name of this server and its URL. Browsers, agents and GitHub use it.
IDP_HOST=helmsman.example.com
IDP_BASE_URL=https://helmsman.example.com
# Empty for a public name (Let's Encrypt). "tls internal" for a private name.
CADDY_TLS=

IDP_SESSION_KEY=
IDP_ENCRYPTION_KEY=
IDP_ALLOWED_ORGS=
IDP_BOOTSTRAP_ADMIN_GITHUB_IDS=
IDP_GITHUB_MODE=real
IDP_DISPLAY_TZ=Africa/Lagos
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
# Absolute path on the host, outside the repository checkout.
GITHUB_APP_KEY_FILE=/opt/helmsman-secrets/github-app.pem

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Backups (profile "backup"). Defaults use the bundled S3Mock.
BACKUP_BUCKET=helmsman-backups
BACKUP_TIME=02:15
BACKUP_KEEP_DAYS=14
TZ=Africa/Lagos

# Log history (profile "logs": add it to COMPOSE_PROFILES). See docs/logs.md.
# Log history is connected from the Integrations page (admin), not from here. To start with it already
# connected, set IDP_LOKI_URL=http://loki:3100 (an admin can still change it in the UI).
# DOCKER_GID=999                # stat -c %g /var/run/docker.sock
# LOG_HOST_NAME=local            # this host's agent id in the catalog
# LOG_PROJECTS=.+                # regex of compose projects whose container logs are collected
# FARO_ALLOWED_ORIGINS=https://my-web-app.example.com,https://staging.my-web-app.example.com
# LOKI_PUSH_USER=alloy           # only if Alloy on other hosts pushes here
# LOKI_PUSH_PASSWORD_HASH='$2a$14$...'

# Mail viewer (the Mail page). It is connected from the Integrations page (admin). To start with it already connected:
# IDP_MAILPIT_URL=http://mailpit:8025
# IDP_MAILPIT_USER=
# IDP_MAILPIT_PASSWORD=

# Optional emergency admin. Generate the three values with: go run ./cmd/breakglass-init
IDP_BREAKGLASS_ENABLED=false
