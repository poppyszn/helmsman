# Home pilot: add these to the .env made from env.server.example.
# The LAN name or IP that browsers and agents use to reach this server (no domain needed).
IDP_HOST=homeserver.local
IDP_BASE_URL=https://homeserver.local
BACKUP_BUCKET=helmsman-backups
BACKUP_TIME=02:15
BACKUP_KEEP_DAYS=14
TZ=Africa/Lagos
