# Copy to .env. Never commit .env. Generate secrets with: openssl rand -hex 32

# --- Server ---
IDP_BASE_URL=https://idp.example.com
IDP_DATABASE_URL=postgres://helmsman:change-me@postgres:5432/helmsman?sslmode=disable
# 32+ random bytes, hex. Signs cookies.
IDP_SESSION_KEY=
# 32 random bytes, hex. Encrypts stored GitHub user tokens (AES-256-GCM).
IDP_ENCRYPTION_KEY=
# Comma separated GitHub orgs whose members may log in.
IDP_ALLOWED_ORGS=acme-org
# Comma separated numeric GitHub user IDs made admin on first login.
IDP_BOOTSTRAP_ADMIN_GITHUB_IDS=
IDP_CATALOG_PATH=/etc/helmsman/apps.yaml
# real | fake. Use fake for dev and tests (no GitHub calls).
IDP_GITHUB_MODE=real
# Optional local admin (bcrypt password + TOTP). Every use is audited.
IDP_BREAKGLASS_ENABLED=false
# Timezone for display. Data is stored in UTC.
IDP_DISPLAY_TZ=Africa/Lagos
# Listen address inside the container.
IDP_LISTEN=:8080

# --- GitHub OAuth App (login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (dispatch, runs, logs) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# --- Postgres container ---
POSTGRES_PASSWORD=change-me

# --- Agent host (compose.agent.yml) ---
AGENT_VERSION=latest
IDP_JOIN_TOKEN=
DOCKER_GID=999
